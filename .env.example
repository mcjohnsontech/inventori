# Copy to .env. Replace placeholders locally; never commit the resulting file.
DATABASE_URL=postgresql://dayari:CHANGE_ME@localhost:54329/dayari_dev
TEST_DATABASE_URL=postgresql://dayari:CHANGE_ME@localhost:54329/dayari_test
POSTGRES_PASSWORD=CHANGE_ME
NODE_ENV=development
PORT=4000
# Keep local operation loopback-only; Heroku staging explicitly sets 0.0.0.0.
HOST=127.0.0.1
AUTHORITY_MODE=SHOP
# Use a new UUID for each real shop; this ID is for development only.
SHOP_NODE_ID=11111111-1111-4111-8111-111111111111
DEV_ADMIN_EMAIL=admin@dayari.test
DEV_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_LOCAL_PASSWORD
API_URL=http://127.0.0.1:4000
APP_ORIGIN=http://127.0.0.1:3000

# Invitations stay disabled until the private settings below are complete.
# Never email an Admin-generated password. Employees set their own via a one-use link.
INVITATION_TRANSPORT=disabled
INVITATION_LIVE_ENABLED=0
SMTP_SENDER_VERIFIED=0
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# Verified employee-accessible HTTPS origin, without a path/query.
# APP_ORIGIN must also match the origin employees actually use.
APP_PUBLIC_URL=
# Private canonical base64 encoding of 32 cryptographically random bytes.
INVITATION_ENCRYPTION_KEY=

# Hosted staging only (set privately in platform config, never copy local .env).
# DAYARI_DEPLOYMENT=staging
# STAGING_BOOTSTRAP=owner-approved-fresh-database
# STAGING_ADMIN_EMAIL=
# STAGING_ADMIN_PASSWORD=
