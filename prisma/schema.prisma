generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  ADMIN
  MANAGER
  PRODUCTION
}
model OriginNode {
  id           String @id @db.Uuid
  mode         String
  nextSequence BigInt @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  events       OutboxEvent[]
}
model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique
  name         String
  role         Role
  passwordHash String
  active       Boolean @default(true)
  mustChangePassword Boolean @default(false)
  authVersion Int @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  sessions     Session[]
  audits       AuditEvent[]
  commands     CommandResult[]
  membership   ShopMembership?
}
model ShopMembership {
  userId String @id @db.Uuid
  originId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([userId, originId])
  @@index([originId])
}
model Session {
  id        String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  userId    String @db.Uuid
  originId  String? @db.Uuid
  user      User @relation(fields: [userId], references: [id], onDelete: Restrict)
  expiresAt DateTime @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([userId])
}
model LoginAttempt {
  id        String @id @default(uuid()) @db.Uuid
  email     String
  succeeded Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([email, createdAt])
}
model Supplier {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  code      String @unique
  originId  String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  sources   SupplierSource[]
}
model SourceLocation {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  originId  String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  sources   SupplierSource[]
}
model SupplierSource {
  id         String @id @default(uuid()) @db.Uuid
  supplierId String @db.Uuid
  locationId String @db.Uuid
  name       String
  code       String @unique
  originId   String @db.Uuid
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  location   SourceLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  sourcings  ProductSourcing[]
  skuPrefix  SupplierLocationPrefix?
  @@unique([supplierId, locationId])
}
model LocationRegistry {
  id             String @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String @unique
  code           String @unique
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  prefixes       SupplierLocationPrefix[]
}
model SupplierLocationPrefix {
  id         String @id @default(uuid()) @db.Uuid
  sourceId   String @unique @db.Uuid
  registryId String @db.Uuid
  code       String @unique
  originId   String @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  source     SupplierSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  registry   LocationRegistry @relation(fields: [registryId], references: [id], onDelete: Restrict)
}
model Product {
  publicIdentity ProductPublicIdentity?
  id          String @id @default(uuid()) @db.Uuid
  name        String
  description String @default("")
  originId    String @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  variants    Variant[]
  attributes  Attribute[]
  sourcings   ProductSourcing[]
}
model Attribute {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  name      String
  originId  String @db.Uuid
  values    AttributeValue[]
  @@unique([productId, name])
}
model AttributeValue {
  id          String @id @default(uuid()) @db.Uuid
  attributeId String @db.Uuid
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  label       String
  originId    String @db.Uuid
  selections  VariantSelection[]
  @@unique([attributeId, label])
  @@unique([id, attributeId])
}
model Variant {
  id             String @id @default(uuid()) @db.Uuid
  productId      String @db.Uuid
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  name           String
  combinationKey String
  originId       String @db.Uuid
  selections     VariantSelection[]
  skus           SupplierVariantSku[]
  @@unique([productId, combinationKey])
  @@unique([id, productId])
}
model VariantSelection {
  variantId   String @db.Uuid
  attributeId String @db.Uuid
  valueId     String @db.Uuid
  variant     Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  value       AttributeValue @relation(fields: [valueId, attributeId], references: [id, attributeId], onDelete: Restrict)
  @@id([variantId, attributeId])
}
model ProductSourcing {
  id        String @id @default(uuid()) @db.Uuid
  sourceId  String @db.Uuid
  productId String @db.Uuid
  baseCode  String @unique
  source    SupplierSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  originId  String @db.Uuid
  skus      SupplierVariantSku[]
  @@unique([sourceId, productId])
  @@unique([id, productId])
}
model SupplierVariantSku {
  id         String @id @default(uuid()) @db.Uuid
  sourcingId String @db.Uuid
  variantId  String @db.Uuid
  productId  String @db.Uuid
  suffix     String
  fullCode   String @unique
  originId   String @db.Uuid
  sourcing   ProductSourcing @relation(fields: [sourcingId, productId], references: [id, productId], onDelete: Restrict)
  variant    Variant @relation(fields: [variantId, productId], references: [id, productId], onDelete: Restrict)
  @@unique([sourcingId, variantId])
}
model CommandResult {
  id          String @id @default(uuid()) @db.Uuid
  originId    String @db.Uuid
  actorId     String @db.Uuid
  actor       User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  commandType String
  key         String @db.Uuid
  requestHash String
  response    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  @@unique([originId, actorId, commandType, key])
}
model AuditEvent {
  id          String @id @default(uuid()) @db.Uuid
  originId    String @db.Uuid
  actorId     String @db.Uuid
  actor       User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorRole   Role
  commandId   String @db.Uuid
  action      String
  subjectId   String @db.Uuid
  snapshot    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  @@index([subjectId, createdAt])
}
model OutboxEvent {
  id             String @id @default(uuid()) @db.Uuid
  originId       String @db.Uuid
  origin         OriginNode @relation(fields: [originId], references: [id], onDelete: Restrict)
  originSequence BigInt
  schemaVersion  Int @default(1)
  eventType      String
  aggregateId    String @db.Uuid
  commandId      String @db.Uuid
  actorId        String @db.Uuid
  payload        Json
  payloadHash    String
  recordedAt     DateTime @default(now()) @db.Timestamptz(6)
  @@unique([originId, originSequence])
}
model InboxEvent {
  id             String @id @default(uuid()) @db.Uuid
  originId       String @db.Uuid
  eventId        String @db.Uuid
  originSequence BigInt
  payloadHash    String
  schemaVersion  Int
  acceptedAt     DateTime @default(now()) @db.Timestamptz(6)
  @@unique([originId, eventId])
  @@unique([originId, originSequence])
}


// Ledger provenance and deferred completeness constraints are defined in migration SQL.
model DeliveryBatch {
  id String @id @default(uuid()) @db.Uuid
  originId String @db.Uuid
  sourceId String @db.Uuid
  publicCode String
  numberedOn DateTime @db.Date
  dailyOrdinal Int
  deliveredOn DateTime @db.Date
  invoiceReference String?
  acceptedAt DateTime @db.Timestamptz(6)
  snapshot Json
  @@unique([originId, publicCode])
  @@unique([originId, numberedOn, dailyOrdinal])
  @@index([sourceId, deliveredOn])
}
model StockTransaction {
  id String @id @default(uuid()) @db.Uuid
  batchId String? @unique @db.Uuid
  originId String @db.Uuid
  commandId String @unique @db.Uuid
  originSequence BigInt
  type String
  actorId String @db.Uuid
  actorRole Role
  recordedAt DateTime @db.Timestamptz(6)
  @@unique([originId, originSequence])
}
model Receipt {
  id String @id @default(uuid()) @db.Uuid
  batchId String @unique @db.Uuid
  transactionId String @unique @db.Uuid
  sourceId String @db.Uuid
  acceptedAt DateTime @db.Timestamptz(6)
}
model StockLot {
  publicIdentity LotPublicIdentity?
  id String @id @default(uuid()) @db.Uuid
  skuId String @db.Uuid
  batchId String @db.Uuid
  sourceId String @db.Uuid
  originId String @db.Uuid
  @@unique([skuId, batchId])
  @@index([batchId])
}
model ReceiptLine {
  id String @id @default(uuid()) @db.Uuid
  receiptId String @db.Uuid
  batchId String @db.Uuid
  skuId String @db.Uuid
  lotId String @unique @db.Uuid
  lineNumber Int
  usableQuantity BigInt
  damagedQuantity BigInt
  totalQuantity BigInt @default(dbgenerated())
  damageReason String
  snapshot Json
  @@unique([receiptId, skuId])
  @@unique([receiptId, lineNumber])
  @@index([batchId])
}
model StockMovement {
  id String @id @default(uuid()) @db.Uuid
  transactionId String @db.Uuid
  batchId String @db.Uuid
  lotId String @db.Uuid
  receiptLineId String? @db.Uuid
  checkoutLineId String? @unique @db.Uuid
  damageLineId String? @unique @db.Uuid
  damageReviewLineId String? @unique @db.Uuid
  completionLineId String? @unique @db.Uuid
  fromState String
  toState String
  quantity BigInt
  @@unique([receiptLineId, toState])
  @@index([lotId])
  @@index([transactionId])
  @@index([batchId])
}
model StockBalance {
  lotId String @db.Uuid
  state String
  quantity BigInt
  version BigInt @default(1)
  lastTransactionId String @db.Uuid
  @@id([lotId, state])
}

model LabelPrintJob {
 id String @id @default(uuid()) @db.Uuid
 receiptId String @db.Uuid
 originId String @db.Uuid
 actorId String @db.Uuid
 commandId String @unique @db.Uuid
 kind String
 originalJobId String? @db.Uuid
 reason String
 profile Json
 rendererVersion String
 manifestHash String
 totalCopies BigInt
 createdAt DateTime @db.Timestamptz(6)
 @@index([receiptId, createdAt])
}
model LabelPrintJobLine {
 id String @id @default(uuid()) @db.Uuid
 jobId String @db.Uuid
 receiptLineId String @db.Uuid
 lotId String @db.Uuid
 purpose String
 copies BigInt
 payload String
 content Json
 ordinal Int
 @@unique([jobId, lotId, purpose])
 @@unique([jobId, ordinal])
}
model LabelPrintEvent {
 id String @id @default(uuid()) @db.Uuid
 jobId String @db.Uuid
 originId String @db.Uuid
 actorId String @db.Uuid
 commandId String @unique @db.Uuid
 kind String
 chunk String
 attemptId String @db.Uuid
 copies BigInt
 artifactHash String?
 note String
 createdAt DateTime @db.Timestamptz(6)
 @@index([jobId, createdAt])
}

model ProductPublicIdentity {
 productId String @id @db.Uuid
 originId String @db.Uuid
 code String
 policyVersion Int @default(1)
 commandId String @db.Uuid
 assignedAt DateTime @default(now()) @db.Timestamptz(6)
 product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
 @@unique([originId, code])
}
model LotPublicIdentity {
 lotId String @id @db.Uuid
 originId String @db.Uuid
 code String
 policyVersion Int @default(1)
 commandId String @db.Uuid
 assignedAt DateTime @default(now()) @db.Timestamptz(6)
 lot StockLot @relation(fields: [lotId], references: [id], onDelete: Restrict, onUpdate: Restrict)
 @@unique([originId, code])
}

model StaffInvitation {
  id String @id @db.Uuid
  originId String @db.Uuid
  creatorId String @db.Uuid
  creatorVersion Int
  name String
  email String
  role Role
  tokenHash String @unique
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  commandId String @db.Uuid
  state InvitationState?
  events InvitationEvent[]
  mail InvitationMail?
  @@index([originId, createdAt])
}
model InvitationState {
  invitationId String @id @db.Uuid
  invitation StaffInvitation @relation(fields:[invitationId],references:[id],onDelete:Restrict)
  status String @default("PENDING")
  userId String? @db.Uuid
  changedAt DateTime @default(now()) @db.Timestamptz(6)
}
model InvitationEvent {
  id String @id @default(uuid()) @db.Uuid
  invitationId String @db.Uuid
  invitation StaffInvitation @relation(fields:[invitationId],references:[id],onDelete:Restrict)
  type String
  commandId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([invitationId, createdAt])
}
model InvitationMail {
  invitationId String @id @db.Uuid
  invitation StaffInvitation @relation(fields:[invitationId],references:[id],onDelete:Restrict)
  encryptedPayload String?
  status String @default("PENDING")
  attempts Int @default(0)
  availableAt DateTime @default(now()) @db.Timestamptz(6)
  leaseId String? @db.Uuid
  leaseUntil DateTime? @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([status, availableAt])
}

// Serialized identity/history sidecars; original stock/receipt tables stay authoritative.
model SerializationCutover {
  id String @id @default(uuid()) @db.Uuid
  originId String @unique @db.Uuid
  watermark BigInt
  policyVersion Int @default(1)
  migrationName String
  activatedAt DateTime @default(now()) @db.Timestamptz(6)
}
model LotSerialization {
  lotId String @id @db.Uuid
  originId String @db.Uuid
  cutoverId String @db.Uuid
  mode String
  recordedAt DateTime @default(now()) @db.Timestamptz(6)
}
model StockUnit {
  id String @id @db.Uuid
  originId String @db.Uuid
  lotId String @db.Uuid
  receiptLineId String @db.Uuid
  unitCode String
  initialState String
  initialMovementId String @db.Uuid
  registrationCommandId String @db.Uuid
  actorId String @db.Uuid
  actorRole Role
  recordedAt DateTime @db.Timestamptz(6)
  @@unique([originId,unitCode])
  @@unique([id,lotId])
  @@index([receiptLineId,initialState])
  @@index([lotId,id])
  @@index([registrationCommandId])
}
model UnitEvent {
  id String @id @db.Uuid
  unitId String @db.Uuid
  lotId String @db.Uuid
  originId String @db.Uuid
  ordinal Int
  kind String
  fromState String
  toState String
  actorId String @db.Uuid
  actorRole Role
  commandId String @db.Uuid
  movementId String @db.Uuid
  recordedAt DateTime @db.Timestamptz(6)
  details Json
  previousEventId String? @db.Uuid
  checkoutLineId String? @unique @db.Uuid
  damageLineId String? @unique @db.Uuid
  damageReviewLineId String? @unique @db.Uuid
  completionLineId String? @unique @db.Uuid
  @@unique([unitId,ordinal])
  @@index([commandId])
}
model UnitState {
  unitId String @id @db.Uuid
  lotId String @db.Uuid
  originId String @db.Uuid
  state String
  condition String
  custody String
  version BigInt @default(1)
  lastEventId String @unique @db.Uuid
  holderId String? @db.Uuid
  @@index([lotId,state])
}
model UnitCommandManifestPage {
  id String @id @db.Uuid
  commandId String @db.Uuid
  originId String @db.Uuid
  ordinal Int
  members Json
  canonicalPayload String
  payloadHash String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@unique([commandId,ordinal])
}

// Exact-unit printing is separate from historical DYI:1 lot-label evidence.
model UnitLabelJob {
  id String @id @db.Uuid
  originId String @db.Uuid
  actorId String @db.Uuid
  actorRole Role
  commandId String @unique @db.Uuid
  kind String
  originalJobId String? @db.Uuid
  reason String
  profile Json
  rendererVersion String
  manifestHash String
  canonicalManifest String
  totalLabels Int
  createdAt DateTime @db.Timestamptz(6)
  @@index([originId,createdAt])
}
model UnitLabelLine {
  id String @id @db.Uuid
  jobId String @db.Uuid
  unitId String @db.Uuid
  lotId String @db.Uuid
  receiptLineId String @db.Uuid
  ordinal Int
  purpose String
  payload String
  content Json
  originalLineId String? @db.Uuid
  @@unique([jobId,unitId])
  @@unique([jobId,ordinal])
  @@index([unitId])
}
model UnitLabelClaim {
  unitId String @id @db.Uuid
  lineId String @unique @db.Uuid
  jobId String @db.Uuid
}
model UnitLabelArtifact {
  id String @id @db.Uuid
  jobId String @unique @db.Uuid
  originId String @db.Uuid
  actorId String @db.Uuid
  actorRole Role
  commandId String @unique @db.Uuid
  html String
  pdf Bytes
  htmlHash String
  pdfHash String
  layout Json
  pages Int
  createdAt DateTime @db.Timestamptz(6)
}
model UnitLabelEvent {
  id String @id @db.Uuid
  jobId String @db.Uuid
  artifactId String? @db.Uuid
  originId String @db.Uuid
  actorId String @db.Uuid
  actorRole Role
  commandId String @unique @db.Uuid
  kind String
  attemptId String @db.Uuid
  recordedAt DateTime @db.Timestamptz(6)
  @@unique([jobId,kind,attemptId])
  @@index([jobId,recordedAt])
}

model UnitObservation {
  id String @id @db.Uuid
  originId String @db.Uuid
  unitId String @db.Uuid
  lotId String @db.Uuid
  actorId String @db.Uuid
  actorRole Role
  commandId String @unique @db.Uuid
  method String
  recordedAt DateTime @db.Timestamptz(6)
  @@index([unitId,recordedAt,id])
  @@index([originId,actorId,recordedAt])
}

model Checkout {
  id String @id @db.Uuid
  originId String @db.Uuid
  transactionId String @unique @db.Uuid
  actorId String @db.Uuid
  actorRole Role
  commandId String @unique @db.Uuid
  acceptedAt DateTime @db.Timestamptz(6)
  reasonCode String?
  reasonNote String
  orderReference String?
  unitCount Int
  @@index([originId,acceptedAt,id])
  @@index([originId,actorId,acceptedAt])
}
model CheckoutLine {
  id String @id @db.Uuid
  checkoutId String @db.Uuid
  originId String @db.Uuid
  ordinal Int
  unitId String @db.Uuid
  lotId String @db.Uuid
  skuId String @db.Uuid
  batchId String @db.Uuid
  movementId String @unique @db.Uuid
  eventId String @unique @db.Uuid
  reasonCode String?
  reasonNote String
  orderReference String?
  reasonInherited Boolean
  orderInherited Boolean
  initiallyMissingReason Boolean @default(dbgenerated())
  snapshot Json
  @@unique([checkoutId,unitId])
  @@unique([checkoutId,ordinal])
  @@index([unitId])
  @@index([originId,orderReference,checkoutId])
}
model CheckoutException {
  id String @id @db.Uuid
  checkoutId String @db.Uuid
  lineId String @unique @db.Uuid
  originId String @db.Uuid
  commandId String @db.Uuid
  createdAt DateTime @db.Timestamptz(6)
  @@index([originId,createdAt,id])
}


model ReasonReconciliation {
  id String @id @db.Uuid
  originId String @db.Uuid
  actorId String @db.Uuid
  actorRole Role
  commandId String @unique @db.Uuid
  recordedAt DateTime @db.Timestamptz(6)
  reasonCode String
  reasonNote String
  remarks String
  exceptionCount Int
  manifest Json
  canonicalManifest String
  manifestHash String
  @@index([originId,recordedAt,id])
}
model CheckoutReasonResolution {
  id String @id @db.Uuid
  originId String @db.Uuid
  reconciliationId String @db.Uuid
  exceptionId String @unique @db.Uuid
  checkoutLineId String @db.Uuid
  checkoutId String @db.Uuid
  unitId String @db.Uuid
  @@index([reconciliationId])
  @@index([unitId])
}

model DamageReport {
 id String @id @db.Uuid
 originId String @db.Uuid
 actorId String @db.Uuid
 actorRole Role
 commandId String @unique @db.Uuid
 transactionId String @unique @db.Uuid
 recordedAt DateTime @db.Timestamptz(6)
 cause String
 description String
 unitCount Int
 manifest Json
 canonicalManifest String
 manifestHash String
 @@index([originId,recordedAt,id])
}
model DamageLine {
 id String @id @db.Uuid
 reportId String @db.Uuid
 originId String @db.Uuid
 unitId String @db.Uuid
 lotId String @db.Uuid
 batchId String @db.Uuid
 fromState String
 previousEventId String @db.Uuid
 checkoutLineId String? @db.Uuid
 movementId String @unique @db.Uuid
 eventId String @unique @db.Uuid
 snapshot Json
 @@unique([reportId,unitId])
 @@index([unitId])
}
model DamageReview {
 id String @id @db.Uuid
 originId String @db.Uuid
 actorId String @db.Uuid
 actorRole Role
 commandId String @unique @db.Uuid
 transactionId String? @unique @db.Uuid
 recordedAt DateTime @db.Timestamptz(6)
 outcome String
 note String
 unitCount Int
 manifest Json
 canonicalManifest String
 manifestHash String
 @@index([originId,recordedAt,id])
}
model DamageReviewLine {
 id String @id @db.Uuid
 reviewId String @db.Uuid
 originId String @db.Uuid
 unitId String @db.Uuid
 lotId String @db.Uuid
 batchId String @db.Uuid
 previousEventId String @db.Uuid
 damageLineId String? @db.Uuid
 movementId String? @unique @db.Uuid
 eventId String? @unique @db.Uuid
 snapshot Json
 @@unique([reviewId,unitId])
 @@index([unitId])
}

model AuthorizationRequest {
 id String @id @db.Uuid
 originId String @db.Uuid
 actorId String @db.Uuid
 actorRole Role
 commandId String @unique @db.Uuid
 recordedAt DateTime @db.Timestamptz(6)
 kind String
 status String
 reason String
 evidence String
 lotId String? @db.Uuid
 state String?
 ledgerQuantity BigInt?
 projectionQuantity BigInt?
 observedQuantity BigInt?
 requestedDelta BigInt? @default(dbgenerated())
 unitCount Int
 payload Json
 canonicalEvidence String
 evidenceHash String
 @@index([originId,recordedAt,id])
}
model AuthorizationRequestUnit {
 id String @id @db.Uuid
 requestId String @db.Uuid
 originId String @db.Uuid
 unitId String @db.Uuid
 lotId String @db.Uuid
 previousEventId String @db.Uuid
 recordedVersion BigInt
 damageLineId String? @db.Uuid
 snapshot Json
 @@unique([requestId,unitId])
 @@index([unitId])
}

model ProductionCompletion {
 id String @id @db.Uuid
 originId String @db.Uuid
 actorId String @db.Uuid
 actorRole Role
 commandId String @unique @db.Uuid
 transactionId String @unique @db.Uuid
 recordedAt DateTime @db.Timestamptz(6)
 unitCount Int
 manifest Json
 canonicalManifest String
 manifestHash String
 @@index([originId,recordedAt,id])
}
model ProductionCompletionLine {
 id String @id @db.Uuid
 completionId String @db.Uuid
 originId String @db.Uuid
 unitId String @unique @db.Uuid
 lotId String @db.Uuid
 batchId String @db.Uuid
 checkoutLineId String @unique @db.Uuid
 previousEventId String @unique @db.Uuid
 movementId String @unique @db.Uuid
 eventId String @unique @db.Uuid
 snapshot Json
 @@index([completionId])
}

model CountSession {
 id String @id @db.Uuid
